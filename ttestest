        [Range(0f, 1f)] public float bloomIntensity = 0.28f;

        [Tooltip("Порог срабатывания Bloom.")]
        [Range(0f, 5f)] public float bloomThreshold = 0.85f;

        [Tooltip("Рассеивание Bloom (Scatter).")]
        [Range(0.1f, 0.95f)] public float bloomScatter = 0.68f;

        [Tooltip("Контрастность изображения (Color Adjustments).")]
        [Range(-50f, 50f)] public float contrast = 14f;

        [Tooltip("Насыщенность цветов (Saturation). Слегка приглушенная насыщенность делает дождливую ночь кинематографичной.")]
