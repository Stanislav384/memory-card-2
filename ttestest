    [CustomEditor(typeof(HDRPRainyNightController))]
    public class HDRPRainyNightControllerEditor : Editor
    {
        public override void OnInspectorGUI()
        {
            HDRPRainyNightController ctrl = (HDRPRainyNightController)target;

            EditorGUILayout.Space(4);
            EditorGUILayout.HelpBox(
                "Unity 6.6 LTS HDRP — Контроллер ночного дождя, густого тумана и Луны.\n" +
                "Вы также можете открыть удобное окно инструмента: Tools > HDRP Rainy Night Atmosphere Tool.",
                MessageType.Info);

            EditorGUILayout.BeginHorizontal();
            if (GUILayout.Button("Неглубокая ночь + Дождь (База)", GUILayout.Height(26)))
            {
                Undo.RecordObject(ctrl, "Apply Rainy Night Preset");
                ctrl.ApplyPreset(AtmospherePresetType.LightRainThickFogNight);
            }
            if (GUILayout.Button("Густой туман + Крупная Луна", GUILayout.Height(26)))
            {
                Undo.RecordObject(ctrl, "Apply Heavy Mist Preset");
                ctrl.ApplyPreset(AtmospherePresetType.HeavyMistGiantMoon);
            }
            EditorGUILayout.EndHorizontal();

            EditorGUILayout.BeginHorizontal();
            if (GUILayout.Button("Штормовая пасмурная ночь", GUILayout.Height(26)))
            {
                Undo.RecordObject(ctrl, "Apply Stormy Night Preset");
                ctrl.ApplyPreset(AtmospherePresetType.StormyOvercastNight);
            }
            if (GUILayout.Button("Оптимизированный (High FPS)", GUILayout.Height(26)))
            {
                Undo.RecordObject(ctrl, "Apply Performance Preset");
                ctrl.ApplyPreset(AtmospherePresetType.PerformanceNight);
            }
            EditorGUILayout.EndHorizontal();

            EditorGUILayout.Space(6);
            if (GUILayout.Button("Создать / Обновить графику на сцене", GUILayout.Height(32)))
            {
                Undo.RecordObject(ctrl, "Build Or Update HDRP Atmosphere");
                ctrl.BuildOrUpdateAtmosphere();
            }

            EditorGUILayout.Space(6);
            DrawDefaultInspector();
        }
    }

    /// <summary>
    /// Полноценное окно инструмента (EditorWindow) в верхнем меню Unity:
    /// Tools > HDRP Rainy Night Atmosphere Tool
    /// Позволяет в 1 клик создать сцену, переключать пресеты графики и тонко настраивать все параметры.
    /// </summary>
    public class HDRPRainyNightEditorWindow : EditorWindow
    {
        private HDRPRainyNightController m_Controller;
        private Vector2 m_ScrollPos;
        private bool m_FoldoutMoon = true;
        private bool m_FoldoutSky = true;
        private bool m_FoldoutFog = true;
        private bool m_FoldoutRain = true;
        private bool m_FoldoutPost = true;

        [MenuItem("Tools/HDRP Rainy Night Atmosphere Tool", false, 100)]
        public static void ShowWindow()
        {
            HDRPRainyNightEditorWindow window = GetWindow<HDRPRainyNightEditorWindow>("HDRP Rainy Night Tool");
            window.minSize = new Vector2(440f, 640f);
            window.Show();
        }

        private void OnFocus()
        {
            FindControllerInScene();
        }

        private void FindControllerInScene()
        {
            if (m_Controller == null)
            {
                m_Controller = FindFirstObjectByType<HDRPRainyNightController>();
            }
        }

        private void OnGUI()
        {
            FindControllerInScene();

            EditorGUILayout.Space(6);
            GUIStyle titleStyle = new GUIStyle(EditorStyles.boldLabel)
            {
                fontSize = 14,
                alignment = TextAnchor.MiddleCenter
            };
            EditorGUILayout.LabelField("Unity 6.6 LTS HDRP — Ночной дождь, туман и Луна", titleStyle);
            EditorGUILayout.Space(4);

            // Проверка наличия контроллера на сцене
            if (m_Controller == null)
            {
                EditorGUILayout.HelpBox(
                    "На текущей сцене еще не создан контроллер атмосферы.\n" +
                    "Нажмите кнопку ниже, чтобы автоматически создать Global Volume (Небо, Облака, Густой туман, Постобработка), Луну и систему частиц дождя.",
                    MessageType.Warning);

                if (GUILayout.Button("Создать атмосферу на сцене (One-Click Setup)", GUILayout.Height(40)))
                {
                    CreateControllerInScene();
                }
                return;
            }

            RainyNightSettings s = m_Controller.settings;
            EditorGUI.BeginChangeCheck();

            // Панель быстрых пресетов
            EditorGUILayout.BeginVertical("box");
            EditorGUILayout.LabelField("Быстрые пресеты графики и атмосферы", EditorStyles.boldLabel);

            EditorGUILayout.BeginHorizontal();
            if (GUILayout.Button("Базовый: Ночь, Туман, Дождь, Луна", GUILayout.Height(28)))
            {
                Undo.RecordObject(m_Controller, "Preset: Light Rain Thick Fog Night");
                m_Controller.ApplyPreset(AtmospherePresetType.LightRainThickFogNight);
            }
            if (GUILayout.Button("Густой туман и Крупная Луна", GUILayout.Height(28)))
            {
                Undo.RecordObject(m_Controller, "Preset: Heavy Mist Giant Moon");
                m_Controller.ApplyPreset(AtmospherePresetType.HeavyMistGiantMoon);
            }
            EditorGUILayout.EndHorizontal();

            EditorGUILayout.BeginHorizontal();
            if (GUILayout.Button("Пасмурный ночной ливень", GUILayout.Height(28)))
            {
                Undo.RecordObject(m_Controller, "Preset: Stormy Overcast Night");
                m_Controller.ApplyPreset(AtmospherePresetType.StormyOvercastNight);
            }
            if (GUILayout.Button("Оптимизированный (High FPS)", GUILayout.Height(28)))
            {
                Undo.RecordObject(m_Controller, "Preset: Performance Night");
                m_Controller.ApplyPreset(AtmospherePresetType.PerformanceNight);
            }
            EditorGUILayout.EndHorizontal();

            EditorGUILayout.Space(4);
            s.qualityTier = (GraphicsQualityTier)EditorGUILayout.EnumPopup("Уровень качества HDRP", s.qualityTier);
            EditorGUILayout.EndVertical();

            // Работа с ассетами пресетов (ScriptableObject)
            EditorGUILayout.BeginVertical("box");
            EditorGUILayout.BeginHorizontal();
            m_Controller.activePresetAsset = (HDRPRainyNightPresetAsset)EditorGUILayout.ObjectField(
                "Файл пресета (.asset)", m_Controller.activePresetAsset, typeof(HDRPRainyNightPresetAsset), false);

            if (GUILayout.Button("Загрузить", GUILayout.Width(80)) && m_Controller.activePresetAsset != null)
            {
                Undo.RecordObject(m_Controller, "Load Preset Asset");
                JsonUtility.FromJsonOverwrite(JsonUtility.ToJson(m_Controller.activePresetAsset.settings), m_Controller.settings);
                m_Controller.ApplySettingsToScene();
            }
            if (GUILayout.Button("Сохранить как...", GUILayout.Width(110)))
            {
                SaveCurrentSettingsAsAsset(s);
            }
            EditorGUILayout.EndHorizontal();
            EditorGUILayout.EndVertical();

            // Скролл-область с детальными настройками
            m_ScrollPos = EditorGUILayout.BeginScrollView(m_ScrollPos);

            // 1. Ночь и Луна
            m_FoldoutMoon = EditorGUILayout.BeginFoldoutHeaderGroup(m_FoldoutMoon, "1. Ночь и Луна (Directional Light & Celestial Body)");
            if (m_FoldoutMoon)
            {
                EditorGUILayout.BeginVertical("box");
                s.moonElevation = EditorGUILayout.Slider("Высота Луны (°)", s.moonElevation, 5f, 85f);
                s.moonAzimuth = EditorGUILayout.Slider("Азимут Луны (°)", s.moonAzimuth, 0f, 360f);
                s.moonIntensityLux = EditorGUILayout.Slider("Яркость света (Lux)", s.moonIntensityLux, 0.2f, 12f);
                s.moonColorTemperature = EditorGUILayout.Slider("Температура света (K)", s.moonColorTemperature, 3000f, 9000f);
                s.moonLightColor = EditorGUILayout.ColorField("Оттенок света Луны", s.moonLightColor);
                EditorGUILayout.Space(3);
                s.moonAngularDiameter = EditorGUILayout.Slider("Размер диска Луны (°)", s.moonAngularDiameter, 0.5f, 8.0f);
                s.moonSurfaceTint = EditorGUILayout.ColorField("Цвет диска Луны", s.moonSurfaceTint);
                s.moonFlareSize = EditorGUILayout.Slider("Размер ореола (Flare Size)", s.moonFlareSize, 0f, 45f);
                s.moonFlareFalloff = EditorGUILayout.Slider("Затухание ореола", s.moonFlareFalloff, 1f, 30f);
                s.moonFlareMultiplier = EditorGUILayout.Slider("Яркость ореола", s.moonFlareMultiplier, 0f, 1f);
                s.moonFlareTint = EditorGUILayout.ColorField("Цвет ореола Луны", s.moonFlareTint);
                s.moonVolumetricDimmer = EditorGUILayout.Slider("Объемный свет Луны в тумане", s.moonVolumetricDimmer, 0f, 8f);
                s.useMoonPhaseReflection = EditorGUILayout.Toggle("Режим фазы Луны (Reflect)", s.useMoonPhaseReflection);
                if (s.useMoonPhaseReflection)
                {
                    s.moonPhase = EditorGUILayout.Slider("Фаза Луны (1 = полная)", s.moonPhase, 0f, 1f);
                    s.moonEarthshine = EditorGUILayout.Slider("Пепельный свет (Earthshine)", s.moonEarthshine, 0f, 1f);
                }
                EditorGUILayout.EndVertical();
            }
            EditorGUILayout.EndFoldoutHeaderGroup();

            // 2. Дождливое небо и облака
            m_FoldoutSky = EditorGUILayout.BeginFoldoutHeaderGroup(m_FoldoutSky, "2. Дождливое небо и Облака (Physically Based Sky & Clouds)");
            if (m_FoldoutSky)
            {
                EditorGUILayout.BeginVertical("box");
                s.skyAerosolDensity = EditorGUILayout.Slider("Атмосферная дымка (Aerosols)", s.skyAerosolDensity, 0f, 1f);
                s.skyZenithTint = EditorGUILayout.ColorField("Цвет зенита ночи", s.skyZenithTint);
                s.skyHorizonTint = EditorGUILayout.ColorField("Цвет горизонта ночи", s.skyHorizonTint);
                s.starfieldMultiplier = EditorGUILayout.Slider("Яркость звезд в просветах", s.starfieldMultiplier, 0f, 5f);
                EditorGUILayout.Space(3);
                s.enableVolumetricClouds = EditorGUILayout.Toggle("Объемные дождевые облака", s.enableVolumetricClouds);
                if (s.enableVolumetricClouds)
                {
                    s.cloudDensityMultiplier = EditorGUILayout.Slider("Плотность облаков", s.cloudDensityMultiplier, 0f, 1f);
                    s.cloudShapeFactor = EditorGUILayout.Slider("Просветы в тучах (Shape Factor)", s.cloudShapeFactor, 0f, 1f);
                    s.cloudShapeScale = EditorGUILayout.Slider("Масштаб облаков", s.cloudShapeScale, 0.5f, 10f);
                    s.cloudErosionFactor = EditorGUILayout.Slider("Детализация краев (Erosion)", s.cloudErosionFactor, 0f, 1f);
                    s.cloudBottomAltitude = EditorGUILayout.Slider("Высота базы туч (м)", s.cloudBottomAltitude, 500f, 4000f);
                    s.cloudAltitudeRange = EditorGUILayout.Slider("Толщина слоя туч (м)", s.cloudAltitudeRange, 500f, 8000f);
                    s.cloudScatteringTint = EditorGUILayout.ColorField("Оттенок туч", s.cloudScatteringTint);
                    s.cloudSunLightDimmer = EditorGUILayout.Slider("Подсветка туч Луной", s.cloudSunLightDimmer, 0f, 1f);
                }
                s.windSpeed = EditorGUILayout.Slider("Скорость ветра (км/ч)", s.windSpeed, 0f, 100f);
                s.windOrientation = EditorGUILayout.Slider("Направление ветра (°)", s.windOrientation, 0f, 360f);
                EditorGUILayout.EndVertical();
            }
            EditorGUILayout.EndFoldoutHeaderGroup();

            // 3. Густой туман
            m_FoldoutFog = EditorGUILayout.BeginFoldoutHeaderGroup(m_FoldoutFog, "3. Густой объемный туман (HDRP Volumetric Fog)");
            if (m_FoldoutFog)
            {
                EditorGUILayout.BeginVertical("box");
                s.fogAttenuationDistance = EditorGUILayout.Slider("Дистанция видимости (меньше=гуще)", s.fogAttenuationDistance, 5f, 150f);
                s.fogBaseHeight = EditorGUILayout.Slider("Базовая высота тумана (м)", s.fogBaseHeight, -20f, 100f);
                s.fogMaximumHeight = EditorGUILayout.Slider("Верхняя граница тумана (м)", s.fogMaximumHeight, 10f, 300f);
                s.maxFogDistance = EditorGUILayout.Slider("Дальность тумана (м)", s.maxFogDistance, 100f, 5000f);
                s.fogAlbedo = EditorGUILayout.ColorField("Альбедо рассеивания (Albedo)", s.fogAlbedo);
                s.fogTint = EditorGUILayout.ColorField("Цвет глубокого тумана (Tint)", s.fogTint);
                s.fogAnisotropy = EditorGUILayout.Slider("Анизотропия (ореолы света)", s.fogAnisotropy, -0.5f, 0.95f);
                s.fogMultipleScattering = EditorGUILayout.Slider("Мягкое рассеивание (Multi-Scatter)", s.fogMultipleScattering, 0f, 1f);
                s.volumetricFogDepthExtent = EditorGUILayout.Slider("Глубина буфера волюметриков (м)", s.volumetricFogDepthExtent, 16f, 256f);
                EditorGUILayout.EndVertical();
            }
            EditorGUILayout.EndFoldoutHeaderGroup();

            // 4. Небольшой дождь
            m_FoldoutRain = EditorGUILayout.BeginFoldoutHeaderGroup(m_FoldoutRain, "4. Небольшой дождь (Particle System + Splashes)");
            if (m_FoldoutRain)
            {
                EditorGUILayout.BeginVertical("box");
                s.enableRainParticles = EditorGUILayout.Toggle("Включить дождь", s.enableRainParticles);
                if (s.enableRainParticles)
                {
                    s.rainEmissionRate = EditorGUILayout.Slider("Интенсивность (капель/сек)", s.rainEmissionRate, 50f, 2500f);
                    s.rainFallSpeed = EditorGUILayout.Slider("Скорость падения (м/с)", s.rainFallSpeed, 5f, 35f);
                    s.rainDropSize = EditorGUILayout.Slider("Толщина капель", s.rainDropSize, 0.01f, 0.12f);
                    s.rainStretchLength = EditorGUILayout.Slider("Длина шлейфа капли", s.rainStretchLength, 2f, 20f);
                    s.rainColor = EditorGUILayout.ColorField("Цвет и прозрачность капель", s.rainColor);
                    s.rainAreaSize = EditorGUILayout.Slider("Радиус области дождя (м)", s.rainAreaSize, 15f, 80f);
                    s.rainSpawnHeight = EditorGUILayout.Slider("Высота спавна над камерой (м)", s.rainSpawnHeight, 8f, 40f);
                    s.enableRainSplashes = EditorGUILayout.Toggle("Круги/брызги на земле", s.enableRainSplashes);
                }
                EditorGUILayout.EndVertical();
            }
            EditorGUILayout.EndFoldoutHeaderGroup();

            // 5. Постобработка
            m_FoldoutPost = EditorGUILayout.BeginFoldoutHeaderGroup(m_FoldoutPost, "5. Постобработка (Exposure, Bloom, ACES, SSR)");
            if (m_FoldoutPost)
            {
                EditorGUILayout.BeginVertical("box");
                s.fixedExposure = EditorGUILayout.Slider("Экспозиция (меньше = светлее ночь)", s.fixedExposure, 2.0f, 9.0f);
                s.postExposure = EditorGUILayout.Slider("Коррекция яркости (Post Exposure)", s.postExposure, -2.0f, 2.0f);
                s.bloomIntensity = EditorGUILayout.Slider("Интенсивность свечения (Bloom)", s.bloomIntensity, 0f, 1f);
                s.bloomThreshold = EditorGUILayout.Slider("Порог свечения (Threshold)", s.bloomThreshold, 0f, 5f);
                s.bloomScatter = EditorGUILayout.Slider("Мягкость свечения (Scatter)", s.bloomScatter, 0.1f, 0.95f);
                s.contrast = EditorGUILayout.Slider("Контрастность", s.contrast, -50f, 50f);
                s.saturation = EditorGUILayout.Slider("Насыщенность", s.saturation, -50f, 50f);
                s.colorFilter = EditorGUILayout.ColorField("Цветовой фильтр ночи", s.colorFilter);
                s.whiteBalanceTemperature = EditorGUILayout.Slider("Холод/Тепло (White Balance)", s.whiteBalanceTemperature, -50f, 50f);
                s.vignetteIntensity = EditorGUILayout.Slider("Виньетка", s.vignetteIntensity, 0f, 0.6f);
                s.filmGrainIntensity = EditorGUILayout.Slider("Зернистость (Film Grain)", s.filmGrainIntensity, 0f, 1f);
                s.enableWetSSR = EditorGUILayout.Toggle("Отражения на мокрой земле (SSR)", s.enableWetSSR);
                s.ssaoIntensity = EditorGUILayout.Slider("Глубина затенения (SSAO)", s.ssaoIntensity, 0f, 2f);
                EditorGUILayout.EndVertical();
            }
            EditorGUILayout.EndFoldoutHeaderGroup();

            EditorGUILayout.EndScrollView();

            if (EditorGUI.EndChangeCheck())
            {
                Undo.RecordObject(m_Controller, "Modify Rainy Night Settings");
                m_Controller.ApplySettingsToScene();
            }

            EditorGUILayout.Space(6);
            if (GUILayout.Button("Пересобрать / Обновить все компоненты сцены", GUILayout.Height(34)))
            {
                Undo.RecordObject(m_Controller, "Rebuild Rainy Night Scene");
                m_Controller.BuildOrUpdateAtmosphere();
            }
            EditorGUILayout.Space(4);
        }

        private void CreateControllerInScene()
        {
            GameObject go = new GameObject("HDRP_RainyNight_Atmosphere");
            Undo.RegisterCreatedObjectUndo(go, "Create HDRP Rainy Night Atmosphere");
            m_Controller = go.AddComponent<HDRPRainyNightController>();
            m_Controller.settings.ApplyPresetValues(AtmospherePresetType.LightRainThickFogNight);
            m_Controller.BuildOrUpdateAtmosphere();
            Selection.activeGameObject = go;
        }

        private void SaveCurrentSettingsAsAsset(RainyNightSettings currentSettings)
        {
            string path = EditorUtility.SaveFilePanelInProject(
                "Сохранить пресет атмосферы HDRP",
                "HDRPRainyNightPreset",
                "asset",
                "Выберите путь для сохранения пресета настроек");

            if (string.IsNullOrEmpty(path))
                return;

            HDRPRainyNightPresetAsset asset = ScriptableObject.CreateInstance<HDRPRainyNightPresetAsset>();
            JsonUtility.FromJsonOverwrite(JsonUtility.ToJson(currentSettings), asset.settings);
            AssetDatabase.CreateAsset(asset, path);
            AssetDatabase.SaveAssets();
            m_Controller.activePresetAsset = asset;
            EditorGUIUtility.PingObject(asset);
        }
    }
