        [Range(50f, 2500f)] public float rainEmissionRate = 450f;

        [Tooltip("Скорость падения капель дождя (м/с).")]
        [Range(5f, 35f)] public float rainFallSpeed = 16f;

        [Tooltip("Размер капель дождя.")]
        [Range(0.01f, 0.12f)] public float rainDropSize = 0.035f;

        [Tooltip("Растяжение капель в полете (Length Scale).")]
        [Range(2f, 20f)] public float rainStretchLength = 8.5f;

