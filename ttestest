        [Tooltip("Освещенность Луны в Люксах (Lux). Для 'не глубокой ночи' рекомендуется 2.0 - 4.5 Lux в сочетании с экспозицией 4.8 - 5.5.")]
        [Range(0.2f, 12f)] public float moonIntensityLux = 3.2f;

        [Tooltip("Цветовая температура лунного света (Кельвины). 4300-5200K в сочетании с холодным фильтром дают серебристо-голубой свет.")]
