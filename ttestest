        [Range(-50f, 50f)] public float whiteBalanceTemperature = -14f;

        [Tooltip("Интенсивность виньетки по краям экрана.")]
        [Range(0f, 0.6f)] public float vignetteIntensity = 0.26f;

        [Tooltip("Легкая зернистость пленки (Film Grain) для устранения бандинга в густом ночном тумане.")]
        [Range(0f, 1f)] public float filmGrainIntensity = 0.18f;

        [Tooltip("Экранные отражения (SSR) для эффекта мокрых поверхностей под дождем.")]
        public bool enableWetSSR = true;

        [Tooltip("Интенсивность глобального затенения (SSAO).")]
        [Range(0f, 2f)] public float ssaoIntensity = 1.1f;

        /// <summary>
        /// Заполняет настройки значениями выбранного пресета.
        /// </summary>
        public void ApplyPresetValues(AtmospherePresetType preset)
        {
            presetType = preset;
            switch (preset)
            {
                case AtmospherePresetType.LightRainThickFogNight:
                    // Основной запрос: небольшой дождь, густой туман, не глубокая ночь, красивая Луна и дождливое небо
                    qualityTier = GraphicsQualityTier.High;
                    moonElevation = 28f;
                    moonAzimuth = 145f;
                    moonIntensityLux = 3.2f;
                    moonColorTemperature = 4800f;
                    moonLightColor = new Color(0.72f, 0.85f, 1.0f, 1.0f);
                    moonAngularDiameter = 2.8f;
                    moonSurfaceTint = new Color(0.92f, 0.96f, 1.0f, 1.0f);
                    moonFlareSize = 16.0f;
                    moonFlareFalloff = 4.5f;
                    moonFlareMultiplier = 0.65f;
                    moonFlareTint = new Color(0.48f, 0.68f, 1.0f, 1.0f);
                    moonVolumetricDimmer = 2.4f;
                    useMoonPhaseReflection = false;

                    skyAerosolDensity = 0.35f;
                    skyZenithTint = new Color(0.10f, 0.16f, 0.28f, 1.0f);
                    skyHorizonTint = new Color(0.18f, 0.25f, 0.36f, 1.0f);
                    starfieldMultiplier = 0.35f;

                    enableVolumetricClouds = true;
                    cloudDensityMultiplier = 0.68f;
                    cloudShapeFactor = 0.64f; // Просветы в облаках, чтобы Луна красиво просвечивала
                    cloudShapeScale = 3.2f;
                    cloudErosionFactor = 0.75f;
                    cloudBottomAltitude = 1100f;
                    cloudAltitudeRange = 2600f;
                    cloudScatteringTint = new Color(0.42f, 0.52f, 0.68f, 1.0f);
                    cloudSunLightDimmer = 0.90f;
                    cloudAmbientProbeDimmer = 0.75f;
                    windSpeed = 24f;
                    windOrientation = 35f;

                    fogAttenuationDistance = 22f; // Густой туман
                    fogBaseHeight = 8f;
                    fogMaximumHeight = 65f;
                    maxFogDistance = 1200f;
                    fogAlbedo = new Color(0.58f, 0.68f, 0.82f, 1.0f);
                    fogTint = new Color(0.16f, 0.22f, 0.34f, 1.0f);
                    fogAnisotropy = 0.55f;
                    fogMultipleScattering = 0.65f;
                    volumetricFogDepthExtent = 64f;

                    enableRainParticles = true;
                    rainEmissionRate = 450f; // Небольшой дождь
                    rainFallSpeed = 16f;
                    rainDropSize = 0.035f;
                    rainStretchLength = 8.5f;
                    rainColor = new Color(0.68f, 0.78f, 0.92f, 0.28f);
                    rainAreaSize = 35f;
                    rainSpawnHeight = 18f;
                    enableRainSplashes = true;

                    fixedExposure = 5.1f; // Не глубокая ночь (хорошая читаемость окружения)
                    postExposure = 0.25f;
                    bloomIntensity = 0.28f;
                    bloomThreshold = 0.85f;
                    bloomScatter = 0.68f;
                    contrast = 14f;
                    saturation = -12f;
                    colorFilter = new Color(0.86f, 0.92f, 1.0f, 1.0f);
                    whiteBalanceTemperature = -14f;
                    vignetteIntensity = 0.26f;
                    filmGrainIntensity = 0.18f;
                    enableWetSSR = true;
                    ssaoIntensity = 1.1f;
                    break;

                case AtmospherePresetType.HeavyMistGiantMoon:
                    // Очень густой туман, крупная кинематографичная Луна, мелкая морось
                    ApplyPresetValues(AtmospherePresetType.LightRainThickFogNight);
                    presetType = AtmospherePresetType.HeavyMistGiantMoon;
                    qualityTier = GraphicsQualityTier.Ultra;
                    moonElevation = 22f;
                    moonAngularDiameter = 3.8f;
                    moonFlareSize = 24f;
                    moonFlareMultiplier = 0.80f;
                    moonVolumetricDimmer = 3.2f;
                    cloudShapeFactor = 0.70f;
                    fogAttenuationDistance = 14f; // Очень густой туман
                    fogBaseHeight = 12f;
                    fogMaximumHeight = 85f;
                    fogMultipleScattering = 0.82f;
                    rainEmissionRate = 240f; // Легкая морось
                    rainFallSpeed = 12f;
                    rainDropSize = 0.028f;
                    fixedExposure = 4.9f;
                    bloomIntensity = 0.35f;
                    break;

                case AtmospherePresetType.StormyOvercastNight:
                    // Более плотное дождливое небо, сильный ветер, выраженный дождь
                    ApplyPresetValues(AtmospherePresetType.LightRainThickFogNight);
                    presetType = AtmospherePresetType.StormyOvercastNight;
                    qualityTier = GraphicsQualityTier.High;
                    moonElevation = 34f;
                    moonIntensityLux = 2.6f;
                    cloudDensityMultiplier = 0.82f;
                    cloudShapeFactor = 0.56f;
                    cloudBottomAltitude = 900f;
                    windSpeed = 48f;
                    fogAttenuationDistance = 28f;
                    rainEmissionRate = 950f;
                    rainFallSpeed = 22f;
                    rainStretchLength = 11f;
                    fixedExposure = 5.3f;
                    contrast = 18f;
                    saturation = -18f;
                    break;

                case AtmospherePresetType.PerformanceNight:
                    // Оптимизированный пресет для средних/слабых ПК с сохранением атмосферы
                    ApplyPresetValues(AtmospherePresetType.LightRainThickFogNight);
                    presetType = AtmospherePresetType.PerformanceNight;
                    qualityTier = GraphicsQualityTier.Low;
                    rainEmissionRate = 300f;
                    enableRainSplashes = false;
                    enableWetSSR = false;
                    volumetricFogDepthExtent = 48f;
                    break;
            }
        }
    }

    /// <summary>
    /// ScriptableObject для сохранения пользовательских пресетов в проекте (Assets).
    /// </summary>
    [CreateAssetMenu(fileName = "HDRPRainyNightPreset", menuName = "HDRP Atmosphere/Rainy Night Preset", order = 100)]
    public class HDRPRainyNightPresetAsset : ScriptableObject
    {
        public RainyNightSettings settings = new RainyNightSettings();
    }

    /// <summary>
    /// Компонент, удерживающий бокс дождя над активной камерой (в игре и в окне Scene View).
    /// </summary>
    [ExecuteAlways]
    public class HDRPRainFollowCamera : MonoBehaviour
    {
        public float heightOffset = 18f;
        public bool followSceneViewInEditor = true;

        private void LateUpdate()
        {
            Transform targetCam = null;

            if (Application.isPlaying && Camera.main != null)
            {
                targetCam = Camera.main.transform;
            }
#if UNITY_EDITOR
            else if (!Application.isPlaying && followSceneViewInEditor && SceneView.lastActiveSceneView != null && SceneView.lastActiveSceneView.camera != null)
            {
                targetCam = SceneView.lastActiveSceneView.camera.transform;
            }
#endif
            if (targetCam == null && Camera.main != null)
            {
                targetCam = Camera.main.transform;
            }

            if (targetCam != null)
            {
                Vector3 pos = targetCam.position;
                transform.position = new Vector3(pos.x, pos.y + heightOffset, pos.z);
            }
        }
    }

    /// <summary>
    /// Основной компонент-менеджер на сцене, который создает и обновляет Volume, Луну и Дождь.
    /// Может управляться как через инспектор, так и из EditorWindow (Tools > HDRP Rainy Night Atmosphere Tool).
    /// </summary>
    [ExecuteAlways]
    [DisallowMultipleComponent]
    public class HDRPRainyNightController : MonoBehaviour
    {
        public RainyNightSettings settings = new RainyNightSettings();
        public HDRPRainyNightPresetAsset activePresetAsset;

        [Header("Ссылки на объекты сцены (заполняются автоматически)")]
        public Volume globalVolume;
        public Light moonLight;
        public ParticleSystem rainParticleSystem;
        public ParticleSystem splashParticleSystem;

        [SerializeField, HideInInspector]
        private Material m_RainMaterial;
        [SerializeField, HideInInspector]
        private Material m_SplashMaterial;

        private void Reset()
        {
            settings.ApplyPresetValues(AtmospherePresetType.LightRainThickFogNight);
            BuildOrUpdateAtmosphere();
        }

        private void OnValidate()
        {
            if (isActiveAndEnabled && globalVolume != null)
            {
                ApplySettingsToScene();
            }
        }

        /// <summary>
        /// Загружает выбранный встроенный пресет и сразу применяет его к сцене.
        /// </summary>
        public void ApplyPreset(AtmospherePresetType preset)
        {
            settings.ApplyPresetValues(preset);
            BuildOrUpdateAtmosphere();
        }

        /// <summary>
        /// Создает (если отсутствуют) и настраивает все объекты: Global Volume, Directional Light (Луна) и Particle System (Дождь).
        /// </summary>
        public void BuildOrUpdateAtmosphere()
        {
            EnsureVolumeExists();
            EnsureMoonLightExists();
            EnsureRainSystemExists();
            ApplySettingsToScene();
        }

        private void EnsureVolumeExists()
        {
            if (globalVolume == null)
            {
                Transform existing = transform.Find("RainyNight_GlobalVolume");
                if (existing != null)
                    globalVolume = existing.GetComponent<Volume>();
            }

            if (globalVolume == null)
            {
                GameObject volGO = new GameObject("RainyNight_GlobalVolume");
                volGO.transform.SetParent(transform, false);
                globalVolume = volGO.AddComponent<Volume>();
                globalVolume.isGlobal = true;
                globalVolume.priority = 10f;
            }

            if (globalVolume.sharedProfile == null)
            {
                VolumeProfile profile = ScriptableObject.CreateInstance<VolumeProfile>();
                profile.name = "RainyNight_HDRP_Profile";
#if UNITY_EDITOR
                if (!Application.isPlaying)
                {
                    string folderPath = "Assets/Settings";
                    if (!AssetDatabase.IsValidFolder(folderPath))
                    {
                        AssetDatabase.CreateFolder("Assets", "Settings");
                    }
                    string assetPath = AssetDatabase.GenerateUniqueAssetPath(folderPath + "/RainyNight_HDRP_Profile.asset");
                    AssetDatabase.CreateAsset(profile, assetPath);
                    AssetDatabase.SaveAssets();
                }
#endif
                globalVolume.sharedProfile = profile;
            }
        }

        private void EnsureMoonLightExists()
        {
            if (moonLight == null)
            {
                Transform existing = transform.Find("Moon_DirectionalLight");
                if (existing != null)
                    moonLight = existing.GetComponent<Light>();
            }

            if (moonLight == null)
            {
                // Отключаем старые Directional Lights (например, дефолтное Солнце), чтобы они не перебивали ночь
                Light[] allLights = FindObjectsByType<Light>(FindObjectsSortMode.None);
                foreach (Light l in allLights)
                {
                    if (l != null && l.type == LightType.Directional && l.transform.parent != transform)
                    {
                        l.gameObject.SetActive(false);
                    }
                }

                GameObject moonGO = new GameObject("Moon_DirectionalLight");
                moonGO.transform.SetParent(transform, false);
                moonLight = moonGO.AddComponent<Light>();
                moonLight.type = LightType.Directional;
            }

            if (moonLight.GetComponent<HDAdditionalLightData>() == null)
            {
                moonLight.gameObject.AddComponent<HDAdditionalLightData>();
            }
        }

        private void EnsureRainSystemExists()
        {
            if (!settings.enableRainParticles)
            {
                if (rainParticleSystem != null)
                    rainParticleSystem.gameObject.SetActive(false);
                return;
            }

            if (rainParticleSystem == null)
            {
                Transform existing = transform.Find("Rain_ParticleSystem");
                if (existing != null)
                    rainParticleSystem = existing.GetComponent<ParticleSystem>();
            }

            if (rainParticleSystem == null)
            {
                GameObject rainGO = new GameObject("Rain_ParticleSystem");
                rainGO.transform.SetParent(transform, false);
                rainParticleSystem = rainGO.AddComponent<ParticleSystem>();
                rainGO.AddComponent<HDRPRainFollowCamera>();
            }

            rainParticleSystem.gameObject.SetActive(true);

            if (splashParticleSystem == null)
            {
                Transform existingSplash = rainParticleSystem.transform.Find("RainSplashes_SubEmitter");
                if (existingSplash != null)
                    splashParticleSystem = existingSplash.GetComponent<ParticleSystem>();
            }

            if (splashParticleSystem == null)
            {
                GameObject splashGO = new GameObject("RainSplashes_SubEmitter");
                splashGO.transform.SetParent(rainParticleSystem.transform, false);
                splashParticleSystem = splashGO.AddComponent<ParticleSystem>();
            }
        }

        /// <summary>
        /// Применяет текущие параметры RainyNightSettings ко всем компонентам HDRP.
        /// </summary>
        public void ApplySettingsToScene()
        {
            if (globalVolume != null && globalVolume.sharedProfile != null)
            {
                ConfigureVolumeProfile(globalVolume.sharedProfile);
            }

            if (moonLight != null)
            {
                ConfigureMoonLight(moonLight);
            }

            if (settings.enableRainParticles)
            {
                EnsureRainSystemExists();
                if (rainParticleSystem != null)
                    ConfigureRainParticles(rainParticleSystem, splashParticleSystem);
            }
            else if (rainParticleSystem != null)
            {
                rainParticleSystem.gameObject.SetActive(false);
            }

#if UNITY_EDITOR
            if (!Application.isPlaying)
            {
                if (globalVolume != null && globalVolume.sharedProfile != null)
                    EditorUtility.SetDirty(globalVolume.sharedProfile);
                SceneView.RepaintAll();
            }
#endif
        }

        private static T GetOrAddOverride<T>(VolumeProfile profile) where T : VolumeComponent
        {
            if (!profile.TryGet<T>(out T component))
            {
                component = profile.Add<T>(true);
            }
            component.active = true;
            return component;
        }

        private void ConfigureVolumeProfile(VolumeProfile profile)
        {
            // 1. Visual Environment (Physically Based Sky + Dynamic Ambient + Global Wind)
            VisualEnvironment visualEnv = GetOrAddOverride<VisualEnvironment>(profile);
            visualEnv.skyType.Override((int)SkyType.PhysicallyBased);
            visualEnv.skyAmbientMode.Override(SkyAmbientMode.Dynamic);
            visualEnv.windSpeed.Override(settings.windSpeed);
            visualEnv.windOrientation.Override(settings.windOrientation);

            // 2. Physically Based Sky (Атмосфера ночи, аэрозольная дымка, звездное небо)
            PhysicallyBasedSky pbs = GetOrAddOverride<PhysicallyBasedSky>(profile);
            pbs.type.Override(PhysicallyBasedSkyModel.EarthAdvanced);
            pbs.atmosphericScattering.Override(true);
            pbs.aerosolDensity.Override(settings.skyAerosolDensity);
            pbs.aerosolTint.Override(new Color(0.75f, 0.82f, 0.95f));
            pbs.aerosolAnisotropy.Override(0.45f);
            pbs.aerosolMaximumAltitude.Override(2200f);
            pbs.zenithTint.Override(settings.skyZenithTint);
            pbs.horizonTint.Override(settings.skyHorizonTint);
            pbs.horizonZenithShift.Override(0.15f);
            pbs.colorSaturation.Override(0.90f);
            pbs.spaceEmissionMultiplier.Override(settings.starfieldMultiplier);

            // 3. Volumetric Clouds (Дождливое облачное небо с просветами для Луны)
            VolumetricClouds clouds = GetOrAddOverride<VolumetricClouds>(profile);
            clouds.enable.Override(settings.enableVolumetricClouds);
            clouds.localClouds.Override(false);
            clouds.cloudControl.Override(VolumetricClouds.CloudControl.Simple);
            clouds.cloudPreset = VolumetricClouds.CloudPresets.Custom;

            clouds.bottomAltitude.Override(settings.cloudBottomAltitude);
            clouds.altitudeRange.Override(settings.cloudAltitudeRange);
            clouds.densityMultiplier.Override(settings.cloudDensityMultiplier);
            clouds.shapeFactor.Override(settings.cloudShapeFactor);
            clouds.shapeScale.Override(settings.cloudShapeScale);
            clouds.erosionFactor.Override(settings.cloudErosionFactor);
            clouds.erosionScale.Override(85f);
            clouds.erosionNoiseType.Override(VolumetricClouds.CloudErosionNoise.Perlin32);
            clouds.scatteringTint.Override(settings.cloudScatteringTint);
            clouds.powderEffectIntensity.Override(0.45f);
            clouds.multiScattering.Override(0.55f);
            clouds.sunLightDimmer.Override(settings.cloudSunLightDimmer);
            clouds.ambientLightProbeDimmer.Override(settings.cloudAmbientProbeDimmer);
            clouds.shadows.Override(true);
            clouds.shadowOpacity.Override(0.45f);
            clouds.temporalAccumulationFactor.Override(0.85f);
            clouds.ghostingReduction.Override(true);

            // Настройка шагов трассировки облаков в зависимости от выбранного качества
            switch (settings.qualityTier)
            {
                case GraphicsQualityTier.Low:
                    clouds.numPrimarySteps.Override(32);
                    clouds.numLightSteps.Override(4);
                    break;
                case GraphicsQualityTier.Medium:
                    clouds.numPrimarySteps.Override(48);
                    clouds.numLightSteps.Override(6);
                    break;
                case GraphicsQualityTier.High:
                    clouds.numPrimarySteps.Override(64);
                    clouds.numLightSteps.Override(8);
                    break;
                case GraphicsQualityTier.Ultra:
                    clouds.numPrimarySteps.Override(96);
                    clouds.numLightSteps.Override(12);
                    break;
            }

            // 4. Густой объемный туман (Fog + Volumetric Fog)
            Fog fog = GetOrAddOverride<Fog>(profile);
            fog.enabled.Override(true);
            fog.enableVolumetricFog.Override(true);
            fog.colorMode.Override(FogColorMode.SkyColor);
            fog.tint.Override(settings.fogTint);
            fog.albedo.Override(settings.fogAlbedo);
            fog.meanFreePath.Override(settings.fogAttenuationDistance);
            fog.baseHeight.Override(settings.fogBaseHeight);
            fog.maximumHeight.Override(settings.fogMaximumHeight);
            fog.maxFogDistance.Override(settings.maxFogDistance);
            fog.anisotropy.Override(settings.fogAnisotropy);
            fog.depthExtent.Override(settings.volumetricFogDepthExtent);
            fog.globalLightProbeDimmer.Override(0.85f);
            fog.multipleScatteringIntensity.Override(settings.fogMultipleScattering);
            fog.denoisingMode.Override(FogDenoisingMode.Both);

            fog.fogControlMode = FogControl.Balance;
            switch (settings.qualityTier)
            {
                case GraphicsQualityTier.Low:
                    fog.volumetricFogBudget = 0.25f;
                    break;
                case GraphicsQualityTier.Medium:
                    fog.volumetricFogBudget = 0.50f;
                    break;
                case GraphicsQualityTier.High:
                    fog.volumetricFogBudget = 0.75f;
                    break;
                case GraphicsQualityTier.Ultra:
                    fog.volumetricFogBudget = 0.95f;
                    break;
            }

            // 5. Exposure (Фиксированная экспозиция для 'не глубокой ночи')
            Exposure exposure = GetOrAddOverride<Exposure>(profile);
            exposure.mode.Override(ExposureMode.Fixed);
            exposure.fixedExposure.Override(settings.fixedExposure);
            exposure.compensation.Override(0f);

            // 6. Indirect Lighting Controller (поддержка видимости в тенях ночью)
            IndirectLightingController indirect = GetOrAddOverride<IndirectLightingController>(profile);
            indirect.indirectDiffuseLightingMultiplier.Override(1.35f);
            indirect.reflectionLightingMultiplier.Override(1.15f);

            // 7. Bloom (мягкое свечение Луны и мокрых бликов)
            Bloom bloom = GetOrAddOverride<Bloom>(profile);
            bloom.intensity.Override(settings.bloomIntensity);
            bloom.threshold.Override(settings.bloomThreshold);
            bloom.scatter.Override(settings.bloomScatter);
            bloom.tint.Override(new Color(0.80f, 0.88f, 1.0f));
            bloom.highQualityFiltering = settings.qualityTier >= GraphicsQualityTier.High;

            // 8. Tonemapping (ACES для глубокого кино-контраста)
            Tonemapping tonemapping = GetOrAddOverride<Tonemapping>(profile);
            tonemapping.mode.Override(TonemappingMode.ACES);
            tonemapping.useFullACES.Override(true);

            // 9. Color Adjustments & White Balance
            ColorAdjustments colorAdj = GetOrAddOverride<ColorAdjustments>(profile);
            colorAdj.postExposure.Override(settings.postExposure);
            colorAdj.contrast.Override(settings.contrast);
            colorAdj.saturation.Override(settings.saturation);
            colorAdj.colorFilter.Override(settings.colorFilter);

            WhiteBalance wb = GetOrAddOverride<WhiteBalance>(profile);
            wb.temperature.Override(settings.whiteBalanceTemperature);
            wb.tint.Override(2f);

            // 10. Shadows, Midtones, Highlights (холодные синие тени, серебристые блики)
            ShadowsMidtonesHighlights smh = GetOrAddOverride<ShadowsMidtonesHighlights>(profile);
            smh.shadows.Override(new Vector4(0.92f, 0.96f, 1.06f, 0.0f));
            smh.midtones.Override(new Vector4(0.96f, 0.98f, 1.03f, 0.0f));
            smh.highlights.Override(new Vector4(1.0f, 1.02f, 1.08f, 0.0f));

            // 11. Vignette & Film Grain
            Vignette vignette = GetOrAddOverride<Vignette>(profile);
            vignette.mode.Override(VignetteMode.Procedural);
            vignette.intensity.Override(settings.vignetteIntensity);
            vignette.smoothness.Override(0.45f);
            vignette.color.Override(new Color(0.02f, 0.04f, 0.08f));

            FilmGrain grain = GetOrAddOverride<FilmGrain>(profile);
            grain.type.Override(FilmGrainLookup.Thin1);
            grain.intensity.Override(settings.filmGrainIntensity);
            grain.response.Override(0.8f);

            // 12. Screen Space Reflection (мокрый асфальт/земля под дождем) & SSAO
            ScreenSpaceReflection ssr = GetOrAddOverride<ScreenSpaceReflection>(profile);
            ssr.enabled.Override(settings.enableWetSSR);
            ssr.enabledTransparent.Override(settings.enableWetSSR);
            ssr.usedAlgorithm.Override(ScreenSpaceReflectionAlgorithm.PBRAccumulation);
            ssr.minSmoothness = 0.25f;

            ScreenSpaceAmbientOcclusion ssao = GetOrAddOverride<ScreenSpaceAmbientOcclusion>(profile);
            ssao.intensity.Override(settings.ssaoIntensity);
            ssao.radius.Override(1.2f);
            ssao.directLightingStrength.Override(0.4f);

            // 13. Screen Space Lens Flare (тонкие атмосферные блики от Луны)
            ScreenSpaceLensFlare lensFlare = GetOrAddOverride<ScreenSpaceLensFlare>(profile);
            lensFlare.intensity.Override(settings.qualityTier >= GraphicsQualityTier.Medium ? 0.18f : 0f);
            lensFlare.firstFlareIntensity.Override(0.4f);
            lensFlare.secondaryFlareIntensity.Override(0.2f);
            lensFlare.streaksIntensity.Override(0.25f);
            lensFlare.tintColor.Override(new Color(0.55f, 0.75f, 1.0f));
        }

        private void ConfigureMoonLight(Light lightComp)
        {
            // Поворот Луны: X = высота над горизонтом (moonElevation), Y = азимут (moonAzimuth)
            lightComp.transform.rotation = Quaternion.Euler(settings.moonElevation, settings.moonAzimuth, 0f);

            // В Unity 6 (HDRP 17.x) единицы света и интенсивность задаются напрямую на компоненте Light
            lightComp.type = LightType.Directional;
            lightComp.lightUnit = LightUnit.Lux;
            lightComp.intensity = settings.moonIntensityLux;
            lightComp.useColorTemperature = true;
            lightComp.colorTemperature = settings.moonColorTemperature;
            lightComp.color = settings.moonLightColor;
            lightComp.shadows = LightShadows.Soft;

            HDAdditionalLightData hdLight = lightComp.GetComponent<HDAdditionalLightData>();
            if (hdLight == null)
                hdLight = lightComp.gameObject.AddComponent<HDAdditionalLightData>();

            hdLight.EnableColorTemperature(true);
            hdLight.EnableShadows(true);
            hdLight.interactsWithSky = true;

            // Настройка красивого диска Луны и ореола (Celestial Body)
            hdLight.angularDiameter = settings.moonAngularDiameter;
            hdLight.surfaceTint = settings.moonSurfaceTint;
            hdLight.flareSize = settings.moonFlareSize;
            hdLight.flareFalloff = settings.moonFlareFalloff;
            hdLight.flareMultiplier = settings.moonFlareMultiplier;
            hdLight.flareTint = settings.moonFlareTint;

            if (settings.useMoonPhaseReflection)
            {
                hdLight.celestialBodyShadingSource = HDAdditionalLightData.CelestialBodyShadingSource.ReflectSunLight;
                hdLight.moonPhase = settings.moonPhase;
                hdLight.earthshine = settings.moonEarthshine;
            }
            else
            {
                hdLight.celestialBodyShadingSource = HDAdditionalLightData.CelestialBodyShadingSource.Emission;
            }

            // Волюметрики и мягкие тени от Луны
            hdLight.affectsVolumetric = true;
            hdLight.volumetricDimmer = settings.moonVolumetricDimmer;
            hdLight.shadowDimmer = 0.88f;
            hdLight.volumetricShadowDimmer = 0.92f;
            hdLight.shadowTint = new Color(0.06f, 0.10f, 0.20f);
            hdLight.SetShadowResolutionLevel(settings.qualityTier >= GraphicsQualityTier.High ? 2 : 1);
        }

        private void ConfigureRainParticles(ParticleSystem rainPS, ParticleSystem splashPS)
        {
            HDRPRainFollowCamera follow = rainPS.GetComponent<HDRPRainFollowCamera>();
            if (follow != null)
            {
                follow.heightOffset = settings.rainSpawnHeight;
            }
            else
            {
                rainPS.transform.localPosition = new Vector3(0f, settings.rainSpawnHeight, 0f);
            }

            // Основной модуль капель дождя
            var main = rainPS.main;
            main.loop = true;
            main.playOnAwake = true;
            main.simulationSpace = ParticleSystemSimulationSpace.World;
            main.maxParticles = Mathf.CeilToInt(settings.rainEmissionRate * 3.5f);
            main.startLifetime = new ParticleSystem.MinMaxCurve(1.6f, 2.2f);
            main.startSpeed = new ParticleSystem.MinMaxCurve(settings.rainFallSpeed * 0.9f, settings.rainFallSpeed * 1.1f);
            main.startSize = new ParticleSystem.MinMaxCurve(settings.rainDropSize * 0.8f, settings.rainDropSize * 1.2f);
            main.startColor = settings.rainColor;
            main.gravityModifier = 0.35f;

            // Эмиссия (небольшой дождь)
            var emission = rainPS.emission;
            emission.enabled = true;
            emission.rateOverTime = settings.rainEmissionRate;

            // Форма генерации (бокс над камерой)
            var shape = rainPS.shape;
            shape.enabled = true;
            shape.shapeType = ParticleSystemShapeType.Box;
            shape.scale = new Vector3(settings.rainAreaSize, 1.5f, settings.rainAreaSize);
            shape.rotation = new Vector3(90f, 0f, 0f); // Направление вниз по оси Y

            // Наклон капель по направлению ветра из настроек неба
            var vel = rainPS.velocityOverLifetime;
            vel.enabled = true;
            vel.space = ParticleSystemSimulationSpace.World;
            float windRad = settings.windOrientation * Mathf.Deg2Rad;
            float windDrift = settings.windSpeed * 0.08f;
            vel.x = Mathf.Cos(windRad) * windDrift;
            vel.y = 0f;
            vel.z = Mathf.Sin(windRad) * windDrift;

            // Рендерер растянутых капель (Stretched Billboard)
            var renderer = rainPS.GetComponent<ParticleSystemRenderer>();
            renderer.renderMode = ParticleSystemRenderMode.Stretch;
            renderer.velocityScale = 0.04f;
            renderer.lengthScale = settings.rainStretchLength;
            renderer.shadowCastingMode = ShadowCastingMode.Off;
            renderer.receiveShadows = true;
            renderer.sharedMaterial = GetOrCreateRainMaterial(false);

            // Столкновения с землей и круги/брызги
            var collision = rainPS.collision;
            collision.enabled = settings.enableRainSplashes;
            collision.type = ParticleSystemCollisionType.World;
            collision.mode = ParticleSystemCollisionMode.Collision3D;
            collision.dampen = 1.0f;
            collision.bounce = 0.0f;
            collision.lifetimeLoss = 1.0f;
            collision.quality = settings.qualityTier >= GraphicsQualityTier.High
                ? ParticleSystemCollisionQuality.High
                : ParticleSystemCollisionQuality.Medium;

            var subEmitters = rainPS.subEmitters;
            subEmitters.enabled = settings.enableRainSplashes && splashPS != null;

            if (splashPS != null)
            {
                splashPS.gameObject.SetActive(settings.enableRainSplashes);
                if (settings.enableRainSplashes)
                {
                    ConfigureSplashSubEmitter(splashPS, subEmitters);
                }
            }

            if (!rainPS.isPlaying)
            {
                rainPS.Play();
            }
        }

        private void ConfigureSplashSubEmitter(ParticleSystem splashPS, ParticleSystem.SubEmittersModule parentSubEmitters)
        {
            var main = splashPS.main;
            main.loop = false;
            main.playOnAwake = false;
            main.simulationSpace = ParticleSystemSimulationSpace.World;
            main.startLifetime = new ParticleSystem.MinMaxCurve(0.15f, 0.30f);
            main.startSpeed = new ParticleSystem.MinMaxCurve(0.0f, 0.2f);
            main.startSize = new ParticleSystem.MinMaxCurve(0.08f, 0.18f);
            Color splashCol = settings.rainColor;
            splashCol.a = Mathf.Clamp01(settings.rainColor.a * 1.4f);
            main.startColor = splashCol;

            var emission = splashPS.emission;
            emission.enabled = true;
            emission.rateOverTime = 0f;
            emission.SetBursts(new ParticleSystem.Burst[] { new ParticleSystem.Burst(0f, 1) });

            var sizeOverLifetime = splashPS.sizeOverLifetime;
            sizeOverLifetime.enabled = true;
            sizeOverLifetime.size = new ParticleSystem.MinMaxCurve(1f, AnimationCurve.Linear(0f, 0.2f, 1f, 1.5f));

            var splashRenderer = splashPS.GetComponent<ParticleSystemRenderer>();
            splashRenderer.renderMode = ParticleSystemRenderMode.HorizontalBillboard;
            splashRenderer.shadowCastingMode = ShadowCastingMode.Off;
            splashRenderer.sharedMaterial = GetOrCreateRainMaterial(true);

            // Привязываем саб-эмиттер на событие Collision без дублирования
            while (parentSubEmitters.subEmittersCount > 0)
            {
                parentSubEmitters.RemoveSubEmitter(0);
            }
            parentSubEmitters.AddSubEmitter(splashPS, ParticleSystemSubEmitterType.Collision, ParticleSystemSubEmitterProperties.InheritNothing);
        }

        private Material GetOrCreateRainMaterial(bool isSplash)
        {
            Material mat = isSplash ? m_SplashMaterial : m_RainMaterial;
            if (mat != null)
                return mat;

            Shader hdrpShader = Shader.Find("HDRP/Unlit");
            if (hdrpShader == null)
                hdrpShader = Shader.Find("HDRP/Lit");
            if (hdrpShader == null)
                hdrpShader = Shader.Find("Particles/Standard Unlit");

            mat = new Material(hdrpShader);
            mat.name = isSplash ? "HDRP_RainSplash_Mat" : "HDRP_RainDrop_Mat";

            // Настраиваем прозрачный режим HDRP Unlit/Lit через HDMaterial API (Unity 6 HDRP 17.x)
            if (hdrpShader != null && hdrpShader.name.StartsWith("HDRP/"))
            {
                HDMaterial.SetSurfaceType(mat, true); // true = Transparent
                HDMaterial.SetBlendMode(mat, BlendingMode.Additive);
                mat.SetColor("_UnlitColor", Color.white);
                mat.SetColor("_BaseColor", Color.white);
                mat.SetFloat("_EnableFogOnTransparent", 1f);
            }

            // Генерируем мягкую процедурную текстуру капли/круга на воде, чтобы не требовать внешних текстур
            mat.mainTexture = CreateProceduralRainTexture(isSplash);
            if (mat.HasProperty("_UnlitColorMap"))
                mat.SetTexture("_UnlitColorMap", mat.mainTexture);
            if (mat.HasProperty("_BaseColorMap"))
                mat.SetTexture("_BaseColorMap", mat.mainTexture);

            if (isSplash)
                m_SplashMaterial = mat;
            else
                m_RainMaterial = mat;

            return mat;
        }

        private static Texture2D CreateProceduralRainTexture(bool isRing)
        {
            int size = 64;
            Texture2D tex = new Texture2D(size, size, TextureFormat.RGBA32, false);
            tex.name = isRing ? "ProceduralSplashRing" : "ProceduralRainDrop";
            tex.wrapMode = TextureWrapMode.Clamp;

            Vector2 center = new Vector2(size * 0.5f, size * 0.5f);
            float maxRadius = size * 0.5f;

            for (int y = 0; y < size; y++)
            {
                for (int x = 0; x < size; x++)
                {
                    float dist = Vector2.Distance(new Vector2(x, y), center) / maxRadius;
                    float alpha;
                    if (isRing)
                    {
                        // Мягкое кольцо на воде от упавшей капли
                        float ring = 1f - Mathf.Abs(dist - 0.65f) / 0.25f;
                        alpha = Mathf.Clamp01(ring) * (1f - Mathf.Clamp01(dist));
                    }
                    else
                    {
                        // Мягкий градиент для капли дождя
                        alpha = Mathf.Pow(Mathf.Clamp01(1f - dist), 2.2f);
                    }
                    tex.SetPixel(x, y, new Color(1f, 1f, 1f, alpha));
                }
            }
            tex.Apply();
            return tex;
        }
    }

