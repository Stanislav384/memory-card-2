// атмосферы ночного дождя, густого объемного тумана, красивой Луны и
// постобработки в Unity 6 (6000.x / 6.6 LTS) High Definition Render Pipeline (HDRP 17.x).
//
// Официальная документация Unity HDRP 17.x API, используемая в скрипте:
// - Fog Volume Override: https://docs.unity3d.com/Packages/com.unity.render-pipelines.high-definition@17.0/api/UnityEngine.Rendering.HighDefinition.Fog.html
// - PhysicallyBasedSky: https://docs.unity3d.com/Packages/com.unity.render-pipelines.high-definition@17.7/api/UnityEngine.Rendering.HighDefinition.PhysicallyBasedSky.html
// - VolumetricClouds: https://docs.unity3d.com/Packages/com.unity.render-pipelines.high-definition@17.6/manual/create-realistic-clouds-volumetric-clouds.html
// - HDAdditionalLightData: https://docs.unity3d.com/Packages/com.unity.render-pipelines.high-definition@17.0/api/UnityEngine.Rendering.HighDefinition.HDAdditionalLightData.html
// - CelestialBodyShadingSource: https://docs.unity3d.com/Packages/com.unity.render-pipelines.high-definition@17.7/api/UnityEngine.Rendering.HighDefinition.HDAdditionalLightData.CelestialBodyShadingSource.html
// ============================================================================

using System;
using UnityEngine;
using UnityEngine.Rendering;
using UnityEngine.Rendering.HighDefinition;

#if UNITY_EDITOR
using UnityEditor;
#endif

namespace HDRPAtmosphereTools
{
    /// <summary>
    /// Пресеты графики и атмосферы для быстрого переключения в окне инструмента или в рантайме.
    /// </summary>
    public enum AtmospherePresetType
    {
        Custom = 0,
        LightRainThickFogNight = 1,   // Основной: неглубокая ночь, густой туман, легкий дождь, красивая Луна
        HeavyMistGiantMoon = 2,       // Мистический: очень густой туман, крупная Луна, мелкая морось
        StormyOvercastNight = 3,      // Дождливый: плотные тучи, умеренный дождь, контрастный свет
        PerformanceNight = 4          // Оптимизированный: сниженная нагрузка на волюметрики для высокого FPS
    }

    /// <summary>
    /// Уровень качества рендеринга волюметриков и эффектов постобработки.
    /// </summary>
    public enum GraphicsQualityTier
    {
        Low = 0,
        Medium = 1,
        High = 2,
        Ultra = 3
    }

    /// <summary>
    /// Сериализуемая структура со всеми параметрами неба, Луны, тумана, дождя и постобработки.
    /// Можно сохранять в пресеты ScriptableObject или менять в реальном времени.
    /// </summary>
    [Serializable]
    public class RainyNightSettings
